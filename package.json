{
  "name": "hisab-smart-accounting",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "description": "نظام حساب الذكي محاسبة ومخزون ونقاط بيع - Smart Accounting, Inventory & POS",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:prepare": "node scripts/package-desktop.mjs",
    "desktop:build": "next build && node scripts/package-desktop.mjs",
    "desktop": "npm run desktop:build && electron-builder --win portable --config electron-builder.yml",
    "mobile": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:release": "npm --prefix mobile run android:release",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx scripts/db-push.ts",
    "db:import-local": "tsx scripts/import-local-to-supabase.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "platform:provision-admin": "tsx scripts/provision-platform-admin.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@fontsource-variable/cairo": "^5.3.0",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "^0.21.3",
    "arabic-reshaper": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "bidi-js": "^1.0.3",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "lucide-react": "^0.469.0",
    "next": "15.5.29",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
