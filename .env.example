# PostgreSQL connection string. For Supabase use the transaction pooler URL and
# replace PASSWORD locally. Never put this secret in a browser/mobile build.
# DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Download prod-ca-2021.crt from Supabase Database Settings > SSL Configuration.
# Keep the certificate file local (ignored by git) and point to it here.
# SUPABASE_CA_CERT_PATH=certs/supabase-prod-ca-2021.crt
# On serverless hosts (Vercel) there is no local file, so set the PEM inline.
# SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

# Mobile talks to the deployed Next.js API, never to Supabase directly.
# EXPO_PUBLIC_API_URL=https://your-accounting-api.example.com

# Secret used to sign session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET=dev-only-change-me-please-32-chars-minimum-secret

# Optional: enable OpenAI-compatible LLM phrasing for the assistant.
# Numbers always come from the database; the model never computes figures.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
